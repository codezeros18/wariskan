# ─── Google Sheets & Drive ────────────────────────────────────────────────────
# Option A (preferred): path to downloaded service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Option B: inline credentials (use if you can't store a file)
# The private key must have literal \n for newlines (copy from JSON as-is)
GOOGLE_SERVICE_ACCOUNT_EMAIL=wariskan-bot@YOUR_PROJECT_ID.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# Template sheet to copy when a new user onboards (share this with the service account)
GOOGLE_TEMPLATE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# A real sheet for local dev/test (must be shared with service account as Editor)
GOOGLE_SHEET_ID=YOUR_DEV_SHEET_ID_HERE

# ─── Meta App Security ────────────────────────────────────────────────────────
# App Secret from Meta Developer Console → App Settings → Basic
# Required for X-Hub-Signature-256 HMAC validation on incoming webhooks.
META_APP_SECRET=YOUR_META_APP_SECRET

# Comma-separated E.164 phones to permanently block (no spaces)
# e.g. WH_BLOCKED_PHONES=628123456789,628987654321
WH_BLOCKED_PHONES=

# Max inbound messages per user per minute (default: 30)
WH_RATE_LIMIT_PER_MIN=30

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_TOKEN=YOUR_WHATSAPP_PERMANENT_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=wariskan_webhook_verify_2026
WHATSAPP_API_VERSION=v18.0

# Set to 'true' to log outgoing messages without actually calling the WA API.
# Use during development to avoid burning message quota.
WHATSAPP_MOCK_MODE=true

# Max outgoing messages per second (token bucket). Default: 20.
# WA Cloud API allows ~80/sec on high-tier; keep conservative for shared keys.
WHATSAPP_RATE_LIMIT_PER_SEC=20

# ─── Slack error notifications (optional) ─────────────────────────────────────
SLACK_ERROR_WEBHOOK=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ─── Supabase (DEV) ────────────────────────────────────────────────────────────
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── Supabase (PROD) — do NOT use for local testing ───────────────────────────
SUPABASE_PROD_URL=https://YYYYYYYYYYYY.supabase.co
SUPABASE_PROD_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_PROD_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── AI APIs ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://wariskan-n8n.up.railway.app
N8N_API_KEY=YOUR_N8N_API_KEY

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
